# ==============================
# Database
# ==============================
DATABASE_URL=sqlite:///./data/app.db

# ==============================
# LLM Provider (OpenAI-compatible)
# ==============================
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
TEMPERATURE=0.2
MAX_TOKENS=800

# ==============================
# Embeddings
# ==============================
# provider: "openai" or "local" (sentence-transformers, no API key needed)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_KEY=

# ==============================
# Financial News Ingestion
# ==============================
# If empty, the ingestion pipeline runs in mock/demo data mode.
NEWS_API_KEY=
NEWS_API_URL=https://newsapi.org/v2/everything

# ==============================
# Vector Store
# ==============================
VECTOR_DB_PATH=./vector_store
VECTOR_COLLECTION_NAME=financial_documents
TOP_K=5
SIMILARITY_THRESHOLD=0.0

# ==============================
# Chunking
# ==============================
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ==============================
# Chat History
# ==============================
CHAT_HISTORY_WINDOW=6

# ==============================
# API / Security
# ==============================
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8501
RATE_LIMIT_PER_MINUTE=30
